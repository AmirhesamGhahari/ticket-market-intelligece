# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/ticket_tracker

# Pipeline thresholds
# Listings with price <= PRICE_MIN or > PRICE_MAX are flagged as anomalies.
# They are still stored in the transformed table with price_is_anomaly=true.
PRICE_MIN=5.0
PRICE_MAX=5000.0

# Batch sizes for DB writes
STAGE1_BATCH_SIZE=100
STAGE2_BATCH_SIZE=100
