region             = "ca-central-1"
app_name           = "ticket-tracker"

apify_api_token    = "apify_api_REPLACE_ME"
gemini_api_key     = "REPLACE_ME_gemini_api_key"
scrapfly_api_key   = "scp-live-REPLACE_ME"
db_master_username = "ticket_tracker"
db_master_password = "REPLACE_ME_secure_password_min_8_chars"
db_name            = "ticket_tracker"

alert_email    = "you@example.com"
github_owner   = "your-github-username"
github_repo    = "ticket-tracker"
github_branch  = "main"

# All event configs — name (YAML file without .yaml) + event_dates (list of YYYY-MM-DD).
# Single-date events use a one-item list.  Multi-date events list every show date.
# The Lambda uses event_dates to skip past events, scale scrape frequency, and
# generate one StubHub ECS task per upcoming show date.
# Each pipeline CLI checks sources.<pipeline>.enabled in the YAML and skips if false.
# event_configs = [
#   { name = "jonas_brothers_toronto_sep2026",  event_dates = ["2026-09-28"] },
#   { name = "phoebe_bridgers_toronto_2026",    event_dates = ["2026-10-01", "2026-10-02"] },
#   { name = "gorillaz_toronto_oct2026",         event_dates = ["2026-10-04"] },
#   { name = "beabadoobee_toronto_oct2026",      event_dates = ["2026-10-07"] },
#   { name = "monsta_x_toronto_oct2026",         event_dates = ["2026-10-10"] },
#   { name = "olivia_rodrigo_toronto_oct2026",   event_dates = ["2026-10-26"] },
# ]
